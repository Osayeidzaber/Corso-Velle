{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
-%}

<section id="Hero-{{ section.id }}" class="custom-hero {% if section.settings.enable_zoom %}custom-hero--zoom-enabled{% endif %}" data-autoplay="{% if section.settings.enable_carousel and section.settings.autoplay %}true{% else %}false{% endif %}" data-speed="{{ autoplay_speed }}">
  
  {%- capture slides_html -%}
    {%- comment -%} Slide 0 (Main) {%- endcomment -%}
    <div class="custom-hero__slide is-active" data-index="0">
      <div class="custom-hero__media">
        {%- if section.settings.image != blank -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source media="(max-width: 768px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">
            {%- endif -%}
            <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="custom-hero__overlay" style="opacity: {{ overlay_opacity }};"></div>
      
      <div class="custom-hero__content">
        {%- if section.settings.show_subtitle and section.settings.subtitle_text != blank -%}
          <p class="custom-hero__subtitle animate-fade-up" style="--delay: 0.1s">{{ section.settings.subtitle_text | escape }}</p>
        {%- endif -%}
        
        {%- if section.settings.show_title and section.settings.title_text != blank -%}
          <h2 class="custom-hero__title animate-fade-up" style="--delay: 0.3s">{{ section.settings.title_text | escape }}</h2>
        {%- endif -%}
        
        {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
          <div class="custom-hero__buttons animate-fade-up" style="--delay: 0.5s">
            {%- if section.settings.button_1_text != blank -%}
              <a href="{{ section.settings.button_1_link | default: '#' }}" class="custom-hero__btn custom-hero__btn--primary">
                <span>{{ section.settings.button_1_text | escape }}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.button_2_text != blank -%}
              <a href="{{ section.settings.button_2_link | default: '#' }}" class="custom-hero__btn custom-hero__btn--secondary">
                <span>{{ section.settings.button_2_text | escape }}</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    
    {%- comment -%} Additional Carousel Slides {%- endcomment -%}
    {%- if section.settings.enable_carousel -%}
      {%- assign slide_count = 1 -%}
      
      {%- for i in (1..3) -%}
        {%- assign desktop_image_key = 'carousel_image_' | append: i -%}
        {%- assign mobile_image_key = 'carousel_mobile_image_' | append: i -%}
        {%- assign desktop_image = section.settings[desktop_image_key] -%}
        {%- assign mobile_image = section.settings[mobile_image_key] -%}
        
        {%- if desktop_image != blank -%}
          <div class="custom-hero__slide" data-index="{{ slide_count }}">
            <div class="custom-hero__media">
              <picture>
                {%- if mobile_image != blank -%}
                  <source media="(max-width: 768px)" srcset="{{ mobile_image | image_url: width: 1000 }}">
                {%- endif -%}
                <img src="{{ desktop_image | image_url: width: 2000 }}" alt="{{ desktop_image.alt | escape }}" loading="lazy" width="{{ desktop_image.width }}" height="{{ desktop_image.height }}">
              </picture>
            </div>
            <div class="custom-hero__overlay" style="opacity: {{ overlay_opacity }};"></div>
            
            <div class="custom-hero__content">
              {%- if section.settings.show_subtitle and section.settings.subtitle_text != blank -%}
                <p class="custom-hero__subtitle animate-fade-up" style="--delay: 0.1s">{{ section.settings.subtitle_text | escape }}</p>
              {%- endif -%}
              
              {%- if section.settings.show_title and section.settings.title_text != blank -%}
                <h2 class="custom-hero__title animate-fade-up" style="--delay: 0.3s">{{ section.settings.title_text | escape }}</h2>
              {%- endif -%}
              
              {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
                <div class="custom-hero__buttons animate-fade-up" style="--delay: 0.5s">
                  {%- if section.settings.button_1_text != blank -%}
                    <a href="{{ section.settings.button_1_link | default: '#' }}" class="custom-hero__btn custom-hero__btn--primary">
                      <span>{{ section.settings.button_1_text | escape }}</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  {%- endif -%}
                  {%- if section.settings.button_2_text != blank -%}
                    <a href="{{ section.settings.button_2_link | default: '#' }}" class="custom-hero__btn custom-hero__btn--secondary">
                      <span>{{ section.settings.button_2_text | escape }}</span>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
          {%- assign slide_count = slide_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  <div class="custom-hero__slider">
    {{ slides_html }}
  </div>

  {%- if section.settings.enable_carousel and slide_count > 1 -%}
    <div class="custom-hero__dots">
      {%- for i in (0..slide_count) limit: slide_count -%}
        <button class="custom-hero__dot {% if forloop.first %}is-active{% endif %}" data-index="{{ i }}" aria-label="Go to slide {{ i | plus: 1 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .custom-hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: #0a0a0a;
    overflow: hidden;
    color: #ffffff;
    max-width: 100%;
  }

  .custom-hero__slider {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .custom-hero__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 1.5s;
    z-index: 1;
  }

  .custom-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  .custom-hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .custom-hero__media picture,
  .custom-hero__media img,
  .custom-hero__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.3);
    transition: filter 1.5s cubic-bezier(0.4, 0, 0.2, 1), transform 10s linear;
  }

  .custom-hero__slide.is-active .custom-hero__media img,
  .custom-hero__slide.is-active .custom-hero__media svg {
    filter: brightness(1);
  }

  .custom-hero--zoom-enabled .custom-hero__slide .custom-hero__media img,
  .custom-hero--zoom-enabled .custom-hero__slide .custom-hero__media svg {
    transform: scale(1.1);
  }

  .custom-hero--zoom-enabled .custom-hero__slide.is-active .custom-hero__media img,
  .custom-hero--zoom-enabled .custom-hero__slide.is-active .custom-hero__media svg {
    transform: scale(1);
  }

  .custom-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: #000000;
    z-index: 2;
    pointer-events: none;
  }

  .custom-hero__content {
    position: absolute;
    bottom: 10%;
    left: 5%;
    max-width: 800px;
    z-index: 3;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .animate-fade-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1) var(--delay, 0s),
                transform 0.8s cubic-bezier(0.4, 0, 0.2, 1) var(--delay, 0s);
  }

  .custom-hero__slide.is-active .animate-fade-up {
    opacity: 1;
    transform: translateY(0);
  }

  .custom-hero__subtitle {
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
    font-weight: 600;
  }

  .custom-hero__title {
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1.1;
    margin: 0;
    font-weight: 700;
    color: #ffffff;
  }

  .custom-hero__buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .custom-hero__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: #ffffff;
    background: transparent;
    border: 1px solid #ffffff;
    overflow: hidden;
    transition: color 0.3s ease, border-color 0.3s ease;
    z-index: 1;
  }

  .custom-hero__btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #ffffff;
    transform: translateX(-101%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: -1;
  }

  .custom-hero__btn:hover {
    color: #0a0a0a;
  }

  .custom-hero__btn:hover::before {
    transform: translateX(0);
  }

  .custom-hero__btn svg {
    transition: transform 0.3s ease;
  }

  .custom-hero__btn:hover svg {
    transform: translateX(6px);
  }

  .custom-hero__btn--secondary {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .custom-hero__btn--secondary::before {
    background-color: rgba(255, 255, 255, 0.9);
  }

  .custom-hero__dots {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.75rem;
    z-index: 10;
  }

  .custom-hero__dot {
    width: 40px;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.3);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .custom-hero__dot.is-active,
  .custom-hero__dot:hover {
    background-color: #ffffff;
  }

  @media screen and (max-width: 768px) {
    .custom-hero__content {
      bottom: 5%;
      left: 0;
      right: 0;
      padding: 1.5rem;
      align-items: center;
      text-align: center;
    }

    .custom-hero__overlay {
      background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 60%);
      opacity: 1 !important;
    }

    .custom-hero__buttons {
      justify-content: center;
      width: 100%;
    }

    .custom-hero__btn {
      width: 100%;
      justify-content: center;
      padding: 0.875rem 1.5rem;
    }

    .custom-hero__dots {
      bottom: 1rem;
    }
    
    .custom-hero__dot {
      width: 30px;
    }
  }
{% endstylesheet %}

<script>
  (function() {
    const section = document.querySelector('#Hero-{{ section.id }}');
    if (!section) return;

    const slides = section.querySelectorAll('.custom-hero__slide');
    const dots = section.querySelectorAll('.custom-hero__dot');
    const isAutoplay = section.getAttribute('data-autoplay') === 'true';
    const speed = parseInt(section.getAttribute('data-speed'), 10) || 5000;
    
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoplayTimer = null;
    let touchStartX = 0;
    let touchEndX = 0;

    function showSlide(index) {
      // Remove active class from current
      slides[currentIndex].classList.remove('is-active');
      if (dots.length) dots[currentIndex].classList.remove('is-active');

      // Calculate new index with modulo wrapping
      currentIndex = (index + slides.length) % slides.length;

      // Add active class to new
      slides[currentIndex].classList.add('is-active');
      if (dots.length) dots[currentIndex].classList.add('is-active');
    }

    function startAutoplay() {
      if (isAutoplay && !autoplayTimer) {
        autoplayTimer = setInterval(() => {
          showSlide(currentIndex + 1);
        }, speed);
      }
    }

    function resetAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
        startAutoplay();
      }
    }

    // Dot click listeners
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        if (index === currentIndex) return;
        showSlide(index);
        resetAutoplay();
      });
    });

    // Touch swiping
    section.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    section.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const distance = touchEndX - touchStartX;
      if (Math.abs(distance) > 50) {
        if (distance < 0) {
          // Swipe left -> next slide
          showSlide(currentIndex + 1);
        } else {
          // Swipe right -> previous slide
          showSlide(currentIndex - 1);
        }
        resetAutoplay();
      }
    }

    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Main Slide Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable Carousel",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable Zoom Effect",
      "default": true
    },
    {
      "type": "header",
      "content": "Additional Slides",
      "info": "Visible only if Enable Carousel is checked."
    },
    {
      "type": "image_picker",
      "id": "carousel_image_1",
      "label": "Slide 2 Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "carousel_mobile_image_1",
      "label": "Slide 2 Mobile Image"
    },
    {
      "type": "image_picker",
      "id": "carousel_image_2",
      "label": "Slide 3 Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "carousel_mobile_image_2",
      "label": "Slide 3 Mobile Image"
    },
    {
      "type": "image_picker",
      "id": "carousel_image_3",
      "label": "Slide 4 Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "carousel_mobile_image_3",
      "label": "Slide 4 Mobile Image"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "checkbox",
      "id": "show_subtitle",
