{% schema %}
{
  "name": "Product Size Guide",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Size Guide"
    }
  ],
  "presets": [
    {
      "name": "Product Size Guide"
    }
  ]
}
{% endschema %}

<style>
  .product-size-guide {
    margin: 2rem 0;
    padding: 1.5rem;
    background: #fdfdfd;
    border: 1px solid #eee;
    border-radius: 8px;
    font-family: var(--font-body-family);
  }
  .product-size-guide-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .product-size-guide-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }
  .product-size-guide-toggle {
    display: flex;
    gap: 0.5rem;
  }
  .product-size-guide-toggle button {
    background: #eee;
    border: 1px solid #ccc;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .product-size-guide-toggle button.active {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .product-size-guide-content {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  .product-size-guide-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 320px;
  }
  .product-size-guide-table th, .product-size-guide-table td {
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid #eee;
  }
  .product-size-guide-table th {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #555;
    white-space: nowrap;
  }
  .product-size-guide-table tr:hover {
    background: #f9f9f9;
  }
</style>

<div class="product-size-guide" id="ProductSizeGuide-{{ section.id }}" style="display: none;">
  <div class="product-size-guide-header">
    <h2 class="product-size-guide-title">{{ section.settings.title }}</h2>
    <div class="product-size-guide-toggle">
      <button class="sg-toggle-btn active" data-unit="inch">INCH</button>
      <button class="sg-toggle-btn" data-unit="cm">CM</button>
    </div>
  </div>
  
  <div class="product-size-guide-content">
    <table class="product-size-guide-table" id="SizeGuideTable-{{ section.id }}">
      <thead>
        <tr id="SizeGuideTableHeader-{{ section.id }}">
          <!-- Headers populated by JS -->
        </tr>
      </thead>
      <tbody id="SizeGuideTableBody-{{ section.id }}">
        <!-- Rows populated by JS -->
      </tbody>
    </table>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const container = document.getElementById('ProductSizeGuide-{{ section.id }}');
    const tableHeader = document.getElementById('SizeGuideTableHeader-{{ section.id }}');
    const tableBody = document.getElementById('SizeGuideTableBody-{{ section.id }}');
    const toggleBtns = container.querySelectorAll('.sg-toggle-btn');
    let currentUnit = 'inch';
    
    let config = null;

    // We must poll briefly because productSpecConfig might be set dynamically by variant-main-picker
    const checkConfig = setInterval(() => {
      if (window.productSpecConfig && window.productSpecConfig.data) {
        clearInterval(checkConfig);
        config = window.productSpecConfig.data;
        renderTable();
        container.style.display = 'block';
      }
    }, 100);

    // Stop checking after 3 seconds if no config found
    setTimeout(() => {
      clearInterval(checkConfig);
    }, 3000);

    toggleBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        toggleBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentUnit = this.getAttribute('data-unit');
        renderTable();
      });
    });

    function renderTable() {
      if (!config) return;

      // Extract sizes (e.g. S, M, L, XL) and measurement labels
      const sizes = Object.keys(config);
      if (sizes.length === 0) return;
      
      const labels = Object.keys(config[sizes[0]]);

      // Render Header
      let headerHTML = '<th>SIZE</th>';
      labels.forEach(label => {
        headerHTML += `<th>${label}</th>`;
      });
      tableHeader.innerHTML = headerHTML;

      // Render Body
      let bodyHTML = '';
      sizes.forEach(size => {
        bodyHTML += `<tr><td><strong>${size}</strong></td>`;
        labels.forEach(label => {
          let rawValue = config[size][label];
          if (!rawValue) {
            bodyHTML += `<td>-</td>`;
            return;
          }
          
          let numValue = parseFloat(rawValue);
          if (typeof rawValue === 'string' && rawValue.includes('/')) {
            const cleanStr = rawValue.replace(/["']/g, '').trim();
            const parts = cleanStr.split(/\s+/);
            if (parts.length === 2 && parts[1].includes('/')) {
              const whole = parseFloat(parts[0]) || 0;
              const fracParts = parts[1].split('/');
              if (fracParts.length === 2) {
                numValue = whole + (parseFloat(fracParts[0]) / parseFloat(fracParts[1]));
              }
            } else if (parts.length === 1 && parts[0].includes('/')) {
              const fracParts = parts[0].split('/');
              if (fracParts.length === 2) {
                numValue = parseFloat(fracParts[0]) / parseFloat(fracParts[1]);
              }
            }
          }

          if (isNaN(numValue)) {
            bodyHTML += `<td>${rawValue}</td>`;
          } else {
            if (currentUnit === 'cm') {
              let cmValue = (numValue * 2.54).toFixed(1);
              if (cmValue.endsWith('.0')) cmValue = cmValue.slice(0, -2);
              bodyHTML += `<td>${cmValue}</td>`;
            } else {
              bodyHTML += `<td>${rawValue}</td>`;
            }
          }
        });
        bodyHTML += `</tr>`;
      });
      tableBody.innerHTML = bodyHTML;
    }
  });
</script>
