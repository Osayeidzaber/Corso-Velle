            "product_purchased": "Formal Trousers"
          }
        },
        {
          "type": "review",
          "settings": {
            "author_name": "Daniel K.",
            "author_location": "Sydney, Australia",
            "content": "Extremely impressed with the stitching and material texture. Feels like a high-end designer piece at a great price.",
            "product_purchased": "Knitted Polo - Large"
          }
        }
      ]
    }
  ]
}
{% endschema %}
