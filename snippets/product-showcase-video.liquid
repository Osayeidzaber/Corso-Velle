{%- doc -%}
  Renders a standalone showcase video for the product, completely separate from the photo gallery.
  @param {product} product - Product object
{%- enddoc -%}

{%- assign product_videos = product.media | where: 'media_type', 'video' -%}
{%- assign featured_video = product_videos.first -%}

{%- if featured_video != blank -%}
  {%- assign mp4_sources = featured_video.sources | where: 'format', 'mp4' -%}
  {%- assign source_720 = mp4_sources | where: 'height', 720 | first -%}
  {%- assign source_1080 = mp4_sources | where: 'height', 1080 | first -%}
  {%- assign primary_source = source_720 | default: source_1080 | default: mp4_sources.first | default: featured_video.sources.first -%}

  <div class="product-standalone-video" data-standalone-video>
    <video
      class="product-standalone-video__player"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      x5-playsinline
      preload="auto"
      disablepictureinpicture
    >
      {%- if primary_source != blank -%}
        <source src="{{ primary_source.url }}" type="{{ primary_source.mime_type }}">
      {%- endif -%}
      {%- for source in featured_video.sources -%}
        {%- if source.url != primary_source.url -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endif -%}
      {%- endfor -%}
    </video>
    <script>
      (function() {
        var v = document.currentScript.previousElementSibling;
        if (v && v.tagName === 'VIDEO') {
          v.muted = true;
          v.defaultMuted = true;
          v.playsInline = true;
          var p = v.play();
          if (p !== undefined) {
            p.catch(function() {
              window.addEventListener('touchstart', function() { v.play(); }, { once: true, passive: true });
              window.addEventListener('scroll', function() { v.play(); }, { once: true, passive: true });
            });
          }
        }
      })();
    </script>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-information__media media-gallery {
    position: relative !important;
    top: auto !important;
  }

  .product-standalone-video {
    position: relative;
    width: 100%;
    margin-top: calc(var(--image-gap, 16px) + 16px);
    border-radius: var(--media-radius, 0px);
    overflow: hidden;
    background: transparent;
    line-height: 0;
    clear: both;
  }

  .product-standalone-video__player {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--media-radius, 0px);
    object-fit: cover;
  }
{% endstylesheet %}
