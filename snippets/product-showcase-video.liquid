{%- doc -%}
  Renders a standalone showcase video for the product, completely separate from the photo gallery.
  @param {product} product - Product object
{%- enddoc -%}

{%- assign product_videos = product.media | where: 'media_type', 'video' -%}
{%- assign featured_video = product_videos.first -%}

{%- if featured_video != blank -%}
  <div class="product-standalone-video" data-standalone-video>
    <auto-video class="product-standalone-video__player">
      {%- for source in featured_video.sources -%}
        {%- if source.format == 'mp4' -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endif -%}
      {%- endfor -%}
    </auto-video>
  </div>
{%- endif -%}

{% stylesheet %}
  .product-information__media media-gallery {
    position: relative !important;
    top: auto !important;
  }

  .product-standalone-video {
    position: relative;
    width: 100%;
    margin-top: calc(var(--image-gap, 16px) + 16px);
    border-radius: var(--media-radius, 0px);
    overflow: hidden;
    background: transparent;
    line-height: 0;
    clear: both;
  }

  .product-standalone-video__player {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--media-radius, 0px);
    object-fit: cover;
  }
{% endstylesheet %}
