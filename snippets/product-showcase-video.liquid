{%- doc -%}
  Renders a showcase video for the product below the photo gallery.
  @param {product} product - Product object
{%- enddoc -%}

{%- assign p = product | default: closest.product -%}
{%- assign featured_media = nil -%}

{%- for media in p.media -%}
  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
    {%- assign featured_media = media -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if featured_media != blank -%}
  <div class="product-standalone-video" data-standalone-video>
    {%- if featured_media.media_type == 'video' -%}
      {{ featured_media | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto', class: 'product-standalone-video__player' }}
    {%- else -%}
      {{ featured_media | external_video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'product-standalone-video__player' }}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-information__media media-gallery {
    position: relative !important;
    top: auto !important;
  }

  .product-standalone-video {
    position: relative;
    width: 100%;
    margin-top: calc(var(--image-gap, 16px) + 16px);
    border-radius: var(--media-radius, 0px);
    overflow: hidden;
    background: transparent;
    line-height: 0;
    clear: both;
  }

  .product-standalone-video__player {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--media-radius, 0px);
    object-fit: cover;
  }
{% endstylesheet %}
