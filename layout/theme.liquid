<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      {% style %}
        @media (prefers-reduced-motion: no-preference) {
          @view-transition {
            navigation: auto;
          }
        }
      {% endstyle %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'breadcrumb-json-ld' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group" style="position: relative; z-index: 100;">
        {% sections 'header-group' %}
      </div>

      <script>
        window.ThemeHeaderCalc = {
          calculateHeaderGroupHeight: function(header = document.querySelector('#header-component'), headerGroup = document.querySelector('#header-group')) {
            if (!headerGroup) return 0;
            let totalHeight = 0;
            const children = headerGroup.children;
            for (let i = 0; i < children.length; i++) {
              const element = children[i];
              if (element === header || !(element instanceof HTMLElement)) continue;
              totalHeight += element.offsetHeight;
            }
            if (header instanceof HTMLElement && header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              return totalHeight + header.offsetHeight;
            }
            return totalHeight;
          },
          updateTransparentHeaderOffset: function() {
            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');
            const hasHeaderSection = headerGroup?.querySelector('.header-section');
            if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
              document.body.style.setProperty('--transparent-header-offset-boolean', '0');
              return;
            }
            const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');
            const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
            document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
          },
          updateHeaderHeights: function() {
            const header = document.querySelector('header-component');
            if (!(header instanceof HTMLElement)) return;
            const headerHeight = header.offsetHeight;
            const headerGroupHeight = window.ThemeHeaderCalc.calculateHeaderGroupHeight(header);
            const headerTopRow = header.querySelector('.header__row--top');
            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
            if (headerTopRow) {
              window.requestAnimationFrame(function () {
                document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
                header.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
              });
            }
          },
          setHeaderMenuStyle: function() {
            const headerComponent = document.querySelector('#header-component');
            if (headerComponent) {
              const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
              window.requestAnimationFrame(() => {
                const overflowList = headerComponent?.querySelector('overflow-list');
                const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
                headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
              });
            }
          }
        };

        window.ThemeHeaderCalc.updateHeaderHeights();
        window.ThemeHeaderCalc.updateTransparentHeaderOffset();
        window.ThemeHeaderCalc.setHeaderMenuStyle();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script src="{{ 'scroll-reveal.js' | asset_url }}" defer="defer"></script>
    <script>
      (function () {
        function prepareAndPlay(video) {
          if (!video) return;
          video.muted = true;
          video.defaultMuted = true;
          video.playsInline = true;
          video.controls = false;
          video.setAttribute('muted', '');
          video.setAttribute('autoplay', '');
          video.setAttribute('loop', '');
          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');
          video.setAttribute('x5-playsinline', '');

          // Check if the video is actually visible on the screen
          var style = window.getComputedStyle(video);
          if (style.display === 'none' || style.visibility === 'hidden') return;

          if (video.paused) {
            var playPromise = video.play();
            if (playPromise !== undefined) {
              playPromise.catch(function () {
                // Autoplay blocked by browser policy; will automatically start on user interaction
              });
            }
          }
        }

        function playAllVisibleVideos() {
          document.querySelectorAll('video').forEach(prepareAndPlay);
        }

        // 1. Run immediately and on DOM readiness
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', playAllVisibleVideos);
        } else {
          playAllVisibleVideos();
        }
        window.addEventListener('load', playAllVisibleVideos);

        // 2. IntersectionObserver to play videos as they scroll into view
        if ('IntersectionObserver' in window) {
          var videoObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                prepareAndPlay(entry.target);
              }
            });
          }, { threshold: 0.05 });

          document.querySelectorAll('video').forEach(function (v) {
            videoObserver.observe(v);
          });

          // Watch dynamically inserted videos
          if ('MutationObserver' in window) {
            var mutObserver = new MutationObserver(function (mutations) {
              mutations.forEach(function (mut) {
                mut.addedNodes.forEach(function (node) {
                  if (node.nodeType === 1) {
                    if (node.tagName === 'VIDEO') {
                      videoObserver.observe(node);
                      prepareAndPlay(node);
                    }
                    if (node.querySelectorAll) {
                      node.querySelectorAll('video').forEach(function (v) {
                        videoObserver.observe(v);
                        prepareAndPlay(v);
                      });
                    }
                  }
                });
              });
            });
            mutObserver.observe(document.documentElement, { childList: true, subtree: true });
          }
        }

        // 3. User interaction listener (guarantees playback on iOS / Android low power mode or strict policies)
        var triggerEvents = ['touchstart', 'touchend', 'pointerdown', 'click', 'scroll', 'visibilitychange', 'pageshow'];
        triggerEvents.forEach(function (evt) {
          window.addEventListener(evt, playAllVisibleVideos, { passive: true });
        });
      })();
    </script>
  </body>
</html>
